        android:fillColor="#00000000"
        android:strokeColor="#0E1014"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M30,54 L40,54 L44,45.5 L48,63 L52,48.5 L56,54 L78,54" />

    <!-- 一滴血（红色），从十字右下角滴落 -->
